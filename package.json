{
  "name": "mhud",
  "version": "2.0.2",
  "private": true,
  "description": "Themed, dependency-free HUD & UI kit for game mods and live-stream overlays (NUI, OBS, HTML5): vitals, location, economy, equipment, vehicle, kill feed, gifts, broadcast crop, 4 themes.",
  "keywords": [
    "hud",
    "game-ui",
    "nui",
    "gta5",
    "rdr2",
    "overlay",
    "obs",
    "stream",
    "tiktok",
    "ui-kit",
    "css",
    "ai-friendly"
  ],
  "homepage": "https://streamember.github.io/mhud/",
  "bugs": {
    "url": "https://github.com/StreamEmber/mhud/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StreamEmber/mhud.git"
  },
  "license": "MIT",
  "author": "Stream Ember Platform",
  "type": "module",
  "main": "./dist/mhud.js",
  "style": "./dist/mhud.css",
  "exports": {
    ".": {
      "style": "./dist/mhud.css",
      "default": "./dist/mhud.js"
    },
    "./css": "./dist/mhud.css",
    "./css/min": "./dist/mhud.min.css",
    "./js": "./dist/mhud.js",
    "./js/min": "./dist/mhud.min.js",
    "./dist/*": "./dist/*",
    "./kit/*": "./kit/*",
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "scripts": {
    "build": "node tools/build.mjs",
    "icons": "node tools/build-icons.cjs",
    "serve": "npx --yes serve -l 5173 _site",
    "version": "node tools/set-version.mjs && npm run build && git add -A",
    "catalog": "node tools/build-catalog.mjs",
    "site": "npm run build && npm run catalog",
    "dev": "npm run build && node tools/build-catalog.mjs --local"
  },
  "devDependencies": {
    "@mdi/svg": "7.4.47",
    "esbuild": "^0.28.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
